MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
TZ=Europe/Madrid

# Opciones configuradas:
# ----------------------
# MYSQL_DATABASE y MYSQL_USER -> base y usuario de Zabbix; no son secretos
# MYSQL_PASSWORD y MYSQL_ROOT_PASSWORD -> vacías en la plantilla; solo van en el .env
# TZ -> zona horaria que pasa al frontend como PHP_TZ